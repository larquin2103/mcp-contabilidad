# ─────────────────────────────────────────────
# MCP Contabilidad — Variables de entorno
# Copia este archivo como .env y completa los valores
# NUNCA subas .env a Git (ya está en .gitignore)
# ─────────────────────────────────────────────

# Servidor SQL Server
DB_SERVER=192.168.X.X\NOMBRE_INSTANCIA
DB_PORT=1433

# Credenciales (usuario con permiso db_datareader SOLO LECTURA)
DB_USER=mcp_readonly
DB_PASSWORD=cambia_esta_password

# Timeout de conexión en ms (opcional)
DB_CONNECT_TIMEOUT=15000
DB_REQUEST_TIMEOUT=30000

# Entorno (development | production)
NODE_ENV=development
