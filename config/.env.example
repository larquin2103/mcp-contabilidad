# ─────────────────────────────────────────────────────────────────
# MCP Contabilidad — Variables de entorno
# Copia este archivo como .env y completa los valores reales
# NUNCA subas .env a Git (ya está en .gitignore)
# ─────────────────────────────────────────────────────────────────

# ── Servidor principal (CAMA, ANAV, DIR, UBL, UDCT) ──────────────
DB_SERVER_PRINCIPAL=192.168.X.X
DB_PORT_PRINCIPAL=1433
DB_USER_PRINCIPAL=sa
DB_PASSWORD_PRINCIPAL=cambia_esta_password

# ── Servidor Gráfica (AG) ─────────────────────────────────────────
DB_SERVER_AG=192.168.X.X
DB_PORT_AG=1433
DB_USER_AG=sa
DB_PASSWORD_AG=cambia_esta_password

# ── Servidor Fábrica de Envases Flexibles (FEF) ───────────────────
DB_SERVER_FEF=192.168.X.X
DB_PORT_FEF=1433
DB_USER_FEF=sa
DB_PASSWORD_FEF=cambia_esta_password

# ── Timeouts de conexión en ms (opcional) ────────────────────────
DB_CONNECT_TIMEOUT=15000
DB_REQUEST_TIMEOUT=30000

# ── Entorno ───────────────────────────────────────────────────────
NODE_ENV=production
